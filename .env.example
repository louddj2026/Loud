# Optional settings. Copy to .env.local; never commit your .env.local.
# Values below are examples/comments, not credentials.
# Native beat/drum analysis: the setup script uses this default sibling folder.
# CROWD_ANALYSIS_RUNTIME=../Codex/runtimes/crowd2-analysis
# External music folder: alternatively upload tracks through the booth.
# CROWD_ELEMENTS_ROOT=C:/Music
# Leave data in the checkout for the simplest setup.
# CROWD_DATA_ROOT=./data
# Section labelling is an optional, separate WSL setup (docs/DEPENDENCIES.md).
CROWD_SECTION_ANALYSIS=disabled
# For an explicitly configured production LoudLink relay, use a private token:
# CROWD_DJ_TOKEN=
# Do not enable anonymous DJ access on a public server.
