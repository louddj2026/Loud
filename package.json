{
  "name": "loud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 -p 3201",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:fast": "node --experimental-strip-types --test tests/cue-markers.test.mjs tests/assisted-playback.test.mjs tests/assisted-search.test.mjs tests/transition-preview.test.mjs tests/kick-phase-monitor.test.mjs tests/crowd-link.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "analyse": "node --experimental-strip-types scripts/analyse-library.mjs",
    "library:compact": "node --experimental-strip-types scripts/build-dj-library.mjs",
    "start": "next start --hostname 127.0.0.1 -p 3200",
    "setup:analysis": "node scripts/setup-analysis-runtime.mjs",
    "check:analysis": "node scripts/setup-analysis-runtime.mjs --check"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "description": "Loud: a local three-deck DJ booth and LoudLink listener surface",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "license": "SEE LICENSE IN LICENSE"
}
